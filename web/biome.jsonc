// The single source of the TypeScript lint and format config (rules/lang/typescript.md, Lint config).
// A package copies it as biome.jsonc next to its package.json, with ~/.claude/rules/lang/biome/*.grit
// as biome/*.grit. Only the places marked ADAPT differ.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    // ADAPT: the package's sources; generated code excluded.
    "includes": [
      "apps/*/src/**",
      "packages/*/src/**",
      "templates/*/src/**",
      "tests/**",
      "scripts/**",
      "!**/src/gen",
      "!tests/api-examples.generated.ts",
      // Written by scripts/api-index.mjs from the generated pb files.
      "!packages/api/src/index.ts",
      "!**/dist"
    ]
  },
  // ADAPT: "overrides": [{ "includes": ["vite.config.ts"], "linter": { "rules": { "style": { "noDefaultExport": "off" } } } }]
  // for a file whose tool or library contract makes a rule impossible; one rule per file, the reason in a comment.
  // Bans Biome has no rule for: `as` casts (except `as const`) and `unknown`.
  "overrides": [
    // Storybook CSF reads a story file's meta from its default export.
    {
      "includes": ["apps/catalog/src/**/*.stories.tsx"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    // The console host loads the federated ./Routes and ./Nav exposes as default exports (plugin-sdk host contract).
    {
      "includes": ["templates/*/src/embedded.tsx", "templates/*/src/navigation.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    // Vite and Playwright load their config from the default export.
    {
      "includes": ["tests/**/vite.config.ts", "tests/**/playwright.config.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ],
  "plugins": ["./biome/no-type-assertion.grit", "./biome/no-unknown.grit"],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    // Tailwind v4 stylesheets use @theme, @apply and @custom-variant.
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noVar": "error",
        "noDoubleEquals": "error",
        "noTsIgnore": "error",
        "noConsole": "error",
        "noEvolvingTypes": "error",
        "noImplicitAnyLet": "error",
        "useAwait": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "noNamespace": "error",
        "noEnum": "error",
        "noParameterAssign": "error",
        "useImportType": "error"
      },
      "complexity": {
        "noBannedTypes": "error"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      }
    }
  }
}
