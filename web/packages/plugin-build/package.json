{
  "name": "@backplane-labs/backplane-plugin-build",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/backplane-labs/backplane.git",
    "directory": "web/packages/plugin-build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./federation": {
      "types": "./dist/federation.d.ts",
      "import": "./dist/federation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "peerDependencies": {
    "vite": ">=8 <9"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@module-federation/vite": "1.23.0",
    "@vitejs/plugin-react": "6.1.1"
  }
}
