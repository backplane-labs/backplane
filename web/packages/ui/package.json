{
  "name": "@backplane-labs/backplane-ui",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/backplane-labs/backplane.git",
    "directory": "web/packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./theme.css": "./dist/theme.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cp src/theme.css dist/theme.css",
    "prepack": "yarn build"
  },
  "peerDependencies": {
    "i18next": ">=26 <27",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "react-i18next": ">=17 <18"
  },
  "dependencies": {
    "@backplane-labs/backplane-theme": "0.1.1",
    "@grafana/ui": "13.2.3",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react-day-picker": "10.0.1",
    "react-hook-form": "7.89.0",
    "react-resizable-panels": "4.14.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.3.1",
    "@grafana/data": "13.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.1"
  }
}
